# ---------- Supabase ----------
# Project Settings -> API. Use the service_role (secret) key. NEVER put it in the frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- X (Twitter) login ----------
# Used ONLY to log users in.
# oauth1 (default): "Log in with X". X returns id + username during login. $0 per login.
# oauth2 (backup):  one paid profile read per login (about $0.01), needs X API credits.
X_AUTH_MODE=oauth1
# oauth1: console.x.com -> Keys & Tokens -> OAuth 1.0 Keys -> Consumer Key -> Regenerate
X_CONSUMER_KEY=your-consumer-key
X_CONSUMER_SECRET=your-consumer-secret
# oauth2 (backup): shown once when you save User authentication settings
X_CLIENT_ID=your-client-id
X_CLIENT_SECRET=your-client-secret
# Must match the Callback URI in your X app's User authentication settings EXACTLY
X_REDIRECT_URI=https://YOUR-BACKEND.up.railway.app/auth/x/callback

# ---------- Website ----------
# Your Netlify URL (no trailing slash). Add local dev after a comma if needed.
FRONTEND_URL=https://YOUR-SITE.netlify.app,http://localhost:5173

# Random string, at least 32 characters. Generate one in PowerShell:
# $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------- Optional ----------
SESSION_DAYS=7
VERIFY_JOB_MINUTES=5
